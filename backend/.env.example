# Copy to .env and fill in for your environment. Nothing here is a real secret.

# --- Core ---
HOMERUN_ENV=development
HOMERUN_DEBUG=true
HOMERUN_SECRET_KEY=change-me-in-production

# --- Database ---
# SQLite file (WAL mode) for the hackathon; swap for a postgresql:// DSN in production.
HOMERUN_DATABASE_URL=sqlite:///./data/homerun.db

# --- Listing provider ---
# "scraped" (Playwright PropertyGuru scraper), "demo_fixture" (offline) or "authorized" (Parse.bot connector,
# disabled until live credentials + reuse rights are confirmed per PRD section 6/16).
LISTING_PROVIDER=scraped
PARSE_BOT_BASE_URL=
PARSE_BOT_API_KEY=
# Bounds on the live catalog sync (app/bootstrap.py) that runs at startup when LISTING_PROVIDER=
# authorized: how many Parse.bot search result pages (20 listings each) to pull per transaction
# type, whether to also pull rentals, and how many listings get a full detail-page enrichment
# call (accurate property_type/tenure/remaining lease + agent identity).
PARSE_BOT_MAX_SEARCH_PAGES=2
PARSE_BOT_INCLUDE_RENT=true
PARSE_BOT_DETAIL_ENRICH_LIMIT=20
# Parse.bot bills per API call against a daily quota; skip re-syncing while the cached catalog
# is still within this TTL (so e.g. `uvicorn --reload` restarts during dev don't burn it).
PARSE_BOT_SYNC_TTL_MINUTES=30

# --- LLM provider (buyer preference extraction + grounded explanations) ---
# "template" (default, fully offline/deterministic) or "gemini" / "groq".
LLM_PROVIDER=template
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Voice AI (uses GEMINI_API_KEY; independent of LLM_PROVIDER) ---
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_FALLBACK_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Puck

# --- Session / retention ---
SESSION_TTL_HOURS=24

# --- CORS (frontend origins, comma separated) ---
HOMERUN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Deployment metadata (shown on /api/health) ---
HOMERUN_BUILD_SHA=dev

# --- PropertyGuru scraper (LISTING_PROVIDER=scraped; Playwright, no paid API) ---
# The API process scrapes on a timer and writes into the `properties` table. Targets are
# "<propertyguru path>:<max pages>" (20 listings/page). Manual run: python -m app.scraper
SCRAPE_ENABLED=true
SCRAPE_INTERVAL_HOURS=1
SCRAPE_QUICK_PAGES=5
SCRAPE_FULL_EVERY_HOURS=12
SCRAPE_TARGETS=hdb-for-sale:30,condo-for-sale:20
SCRAPE_DELAY_SECONDS=8
SCRAPE_HEADLESS=true
SCRAPE_MAX_RETRIES=3
SCRAPE_STALE_AFTER_HOURS=72
